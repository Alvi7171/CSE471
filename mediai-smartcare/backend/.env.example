# Server Configuration
PORT=1355
NODE_ENV=development

# TiDB Cloud MySQL Database Configuration
# Get these credentials from: https://tidbcloud.com/
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your_tidb_username
DB_PASSWORD=your_tidb_password
DB_NAME=mediai_smartcare
DB_SSL=true

# Groq AI API Configuration (FREE - Recommended)
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Alternative: Hugging Face API (FREE)
# Get your API key from: https://huggingface.co/settings/tokens
# HUGGINGFACE_API_KEY=your_huggingface_api_key_here
