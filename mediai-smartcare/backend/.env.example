# Server Configuration
PORT=1355
NODE_ENV=development
USE_SQLITE=true

# Railway MySQL Configuration
# Use values from Railway MySQL service Variables tab
# For local development, DO NOT use mysql.railway.internal (private network only)
# Option A: Set DATABASE_URL from Railway public URL and leave DB_* unused.
# Option B: Use public host values in DB_* fields below.
DATABASE_URL=
DB_HOST=your-public-railway-host
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_railway_mysql_password
DB_NAME=railway
DB_SSL=true
DB_CONNECTION_LIMIT=10

# JWT Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Notifications / Email Delivery
EMAIL_PROVIDER=brevo
EMAIL_FROM=appointments@example.com
EMAIL_FROM_NAME=MediAI SmartCare
BREVO_API_KEY=
NOTIFICATION_REMINDER_HOURS_DEFAULT=24
NOTIFICATION_PROCESS_INTERVAL_MS=60000
NOTIFICATION_EMAIL_RECIPIENT_SCOPE=patient

# Alternative email provider
# RESEND_API_KEY=

# Groq AI API Configuration (FREE - Recommended)
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=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

# Alternative: Hugging Face API (FREE)
# Get your API key from: https://huggingface.co/settings/tokens
# HUGGINGFACE_API_KEY=your_huggingface_api_key_here
