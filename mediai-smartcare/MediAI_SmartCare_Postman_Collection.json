    {
      "name": "Doctor Scheduling APIs",
      "item": [
        {
          "name": "1. Get All Doctors",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:1355/api/schedule/doctors",
              "protocol": "http",
              "host": ["localhost"],
              "port": "1355",
              "path": ["api", "schedule", "doctors"]
            },
            "description": "Retrieve all available doctors with their details"
          }
        },
        {
          "name": "2. Get Doctor Schedule",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:1355/api/schedule/doctors/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "1355",
              "path": ["api", "schedule", "doctors", "1"]
            },
            "description": "Get specific doctor's schedule by doctor ID"
          }
        },
        {
          "name": "3. Search Doctors by Specialization",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:1355/api/schedule/doctors/search?specialization=Cardiologist",
              "protocol": "http",
              "host": ["localhost"],
              "port": "1355",
              "path": ["api", "schedule", "doctors", "search"],
              "query": [
                {
                  "key": "specialization",
                  "value": "Cardiologist"
                }
              ]
            },
            "description": "Search doctors by specialization or department"
          }
        },
        {
          "name": "4. Create Doctor Schedule",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorId\": 1,\n  \"dayOfWeek\": \"Thursday\",\n  \"startTime\": \"14:00:00\",\n  \"endTime\": \"18:00:00\",\n  \"slotDuration\": 30\n}"
            },
            "url": {
              "raw": "http://localhost:1355/api/schedule/create",
              "protocol": "http",
              "host": ["localhost"],
              "port": "1355",
              "path": ["api", "schedule", "create"]
            },
            "description": "Create a new schedule for a doctor"
          }
        },
        {
          "name": "5. Update Doctor Schedule",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startTime\": \"15:00:00\",\n  \"endTime\": \"19:00:00\",\n  \"slotDuration\": 45\n}"
            },
            "url": {
              "raw": "http://localhost:1355/api/schedule/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "1355",
              "path": ["api", "schedule", "1"]
            },
            "description": "Update an existing schedule by schedule ID"
          }
        },
        {
          "name": "6. Delete Doctor Schedule",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "http://localhost:1355/api/schedule/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "1355",
              "path": ["api", "schedule", "1"]
            },
            "description": "Delete/deactivate a schedule by schedule ID"
          }
        }
      ]
